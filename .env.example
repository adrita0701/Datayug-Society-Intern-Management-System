# Copy to .env for local development. Never commit .env.

# ---- Server
PORT=5000
# Long random string used to sign login tokens. REQUIRED in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Database — the first one configured wins:
#   DATABASE_URL  PostgreSQL connection string (recommended for production)
#   MONGO_URI     MongoDB connection string
#   neither       local JSON file (DATA_FILE, default ./data.json)
DATABASE_URL=
MONGO_URI=
# DATA_FILE=data.json

# When a new database is empty, import data.json into it once (set to false to skip).
# SEED_FROM_JSON=true

# Optional: (re)set the admin login at startup.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Optional: only needed if the frontend is hosted on a different domain.
# CORS_ORIGIN=https://example.org

# ---- Frontend (build time)
# Path the UI is served from: "/" or e.g. "/interns/" behind a reverse proxy.
VITE_BASE_PATH=/
# API location. Leave empty to use the same server as the UI.
# VITE_API_BASE=https://api.example.org
